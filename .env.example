# Cloudflare API Token for Terraform and Wrangler deployment
# Go to Cloudflare Dashboard -> My Profile -> API Tokens
# Requires: D1 (Edit), R2 (Edit), Workers Scripts (Edit)
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token_here"

# AWS / S3 Credentials for Terraform Remote State on Cloudflare R2
# Go to Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
# Terraform S3 backend explicitly looks for AWS_ prefixed environment variables natively
AWS_ACCESS_KEY_ID="your_r2_access_key_id_here"
AWS_SECRET_ACCESS_KEY="your_r2_secret_access_key_here"

# (Optional) If you have custom scripts wrapping terraform that look for these specific keys
S3_ACC_KEY_ID="your_r2_access_key_id_here"
S3_ACC_KEY="your_r2_secret_access_key_here"
