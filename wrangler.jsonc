{
	"compatibility_date": "2026-03-17",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "away",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "away-db",
			"database_id": "88ece8aa-1606-4115-8c6e-bdfc805b4bf2"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "away-bucket"
		}
	]
}