          <p class="text-sm font-semibold text-gray-800 dark:text-gray-200">No Participants Added</p>
          <p class="text-xs text-gray-500 mt-1 mb-4">Add trip participants first to calculate balances and debt settlements.</p>
          <button
            type="button"
            onclick="document.getElementById('settle-up-dialog').close(); document.getElementById('manage-members-dialog').showModal();"
            class="px-4 py-2 bg-sapphire text-white text-xs font-semibold rounded-xl hover:bg-ocean transition-all"
          >
            Add Members Now
          </button>
        </div>
      ) : (
        <div class="space-y-6">
          <!-- Overview Cards -->
          <div class="grid grid-cols-2 gap-3">
            <div class="p-3.5 rounded-2xl bg-pale-sapphire dark:bg-nightfall/60 border border-sky-mist/30 dark:border-sapphire/30">
              <span class="text-[11px] font-medium text-gray-500 dark:text-gray-400">Total Expenses</span>
              <div class="text-lg font-extrabold text-nightfall dark:text-whisper mt-0.5">
                {formatCurrency(settlementSummary.totalAmount, baseCurrency)}
              </div>
            </div>
            <div class="p-3.5 rounded-2xl bg-pale-sapphire dark:bg-nightfall/60 border border-sky-mist/30 dark:border-sapphire/30">
              <span class="text-[11px] font-medium text-gray-500 dark:text-gray-400">Share / Person</span>
              <div class="text-lg font-extrabold text-nightfall dark:text-whisper mt-0.5">
                {formatCurrency(settlementSummary.averagePerPerson, baseCurrency)}
              </div>
            </div>
          </div>

          <!-- Unattributed Warning -->
          {settlementSummary.unattributedCount > 0 && (
            <div class="p-3 rounded-2xl bg-amber-50 dark:bg-amber-900/30 border border-amber-200 dark:border-amber-700 text-xs text-amber-800 dark:text-amber-200 flex items-start gap-2">
              <span class="text-base leading-none">⚠️</span>
              <div>
                <strong>{settlementSummary.unattributedCount} expense(s)</strong> ({formatCurrency(settlementSummary.unattributedTotal, baseCurrency)}) have no payer assigned. Edit them to include in settlement.
              </div>
            </div>
          )}

          <!-- Settlement Transfers Plan -->
          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-gray-400 dark:text-gray-400 mb-2.5">
              🤝 Settlement Plan (Who Pays Whom)
            </h4>
            {settlementSummary.transfers.length === 0 ? (
              <div class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-center text-xs font-semibold">
                🎉 All balances are settled up! No payments needed.
              </div>
            ) : (
              <div class="space-y-2">
                {settlementSummary.transfers.map((t) => (
                  <div class="flex items-center justify-between p-3 rounded-2xl bg-pale-sapphire dark:bg-nightfall/60 border border-sky-mist/30 dark:border-sapphire/30">
                    <div class="flex items-center gap-2">
                      <span class="font-bold text-sm text-gray-900 dark:text-white">{t.from}</span>
                      <span class="text-xs text-gray-400 font-bold">➔</span>
                      <span class="font-bold text-sm text-gray-900 dark:text-white">{t.to}</span>
                    </div>
                    <div class="font-extrabold text-sm text-sapphire dark:text-sky-mist bg-sapphire/10 dark:bg-sky-mist/20 px-2.5 py-1 rounded-xl border border-sapphire/20">
                      {formatCurrency(t.amount, baseCurrency)}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>

          <!-- Individual Net Balances -->
          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-gray-400 dark:text-gray-400 mb-2.5">
              📊 Balances Breakdown
            </h4>
            <div class="space-y-2">
              {settlementSummary.balances.map((b) => (
                <div class="p-3 rounded-2xl bg-gray-50 dark:bg-slate-700/50 border border-gray-100 dark:border-slate-700 flex items-center justify-between">
                  <div>
                    <div class="font-bold text-sm text-gray-900 dark:text-white">{b.name}</div>
                    <div class="text-[11px] text-gray-500 mt-0.5">
                      Paid: {formatCurrency(b.paid, baseCurrency)} · Share: {formatCurrency(b.share, baseCurrency)}
                    </div>
                  </div>
                  <div class="text-right">
                    {b.net > 0 ? (
                      <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-900/30 px-2.5 py-1 rounded-lg">
                        +{formatCurrency(b.net, baseCurrency)}
                      </span>
                    ) : b.net < 0 ? (
                      <span class="text-xs font-bold text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/30 px-2.5 py-1 rounded-lg">
                        -{formatCurrency(-b.net, baseCurrency)}
                      </span>
                    ) : (
                      <span class="text-xs font-medium text-gray-400 bg-gray-100 dark:bg-slate-600 px-2.5 py-1 rounded-lg">
                        Settled
                      </span>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Copy Button -->
          <button
            type="button"
            id="copy-settlement-btn"
            data-text={settlementShareText}
            class="w-full py-3 bg-sapphire text-white font-semibold text-xs rounded-xl hover:bg-ocean active:scale-[0.98] transition-all flex items-center justify-center gap-2 shadow"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
            </svg>
            <span id="copy-settlement-label">Copy Settlement Breakdown to Share</span>
          </button>
        </div>
      )}
    </dialog>
  )}

  <!-- RESOURCES TAB -->
  {currentTab === 'resources' && (
    <div class="space-y-4 animate-in fade-in slide-in-from-bottom-2 duration-300">
      {resources.length === 0 ? (
        <div class="text-center py-16 text-gray-500">
          <div class="text-4xl mb-3">📁</div>
          <p class="font-medium">No resources added yet.</p>
        </div>
      ) : (
        <div class="flex flex-col gap-6">
          {resources.map((item: any) => (
            <div class="group bg-pale-sapphire dark:bg-nightfall/60 p-4 rounded-2xl shadow-sm border border-sky-mist/30 dark:border-sapphire/20 flex flex-col relative w-full overflow-hidden">
              
              <div class="flex justify-between items-start mb-3">
                <span class="text-[10px] font-extrabold text-whisper bg-sapphire px-2 py-0.5 rounded-md uppercase tracking-wider">{item.type}</span>
                
                <form method="POST" action="/api/resources" class="inline" onsubmit="return confirm('Delete this resource?');">
                  <input type="hidden" name="action" value="delete" />
                  <input type="hidden" name="id" value={item.id} />
                  <input type="hidden" name="trip_id" value={id} />
                  <button type="submit" class="p-2 text-red-400 hover:text-red-600 rounded-full hover:bg-red-50/10 transition-colors -m-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                </form>
              </div>

              <h3 class="font-bold text-nightfall dark:text-whisper text-lg mb-2">{item.title}</h3>
              {item.notes && <p class="text-sm text-nightfall/60 dark:text-whisper/60 mb-4">{item.notes}</p>}
              
              <div class="mt-auto">
                {item.type === 'embed' && (item.url.includes('youtube.com') || item.url.includes('youtu.be')) ? (
                  <div class="aspect-video w-full rounded-lg overflow-hidden border border-gray-200 dark:border-slate-700">
                    <iframe 
                      src={(() => {
                        let videoId = '';
                        if (item.url.includes('youtu.be/')) videoId = item.url.split('youtu.be/')[1].split('?')[0];
                        else if (item.url.includes('watch?v=')) videoId = item.url.split('watch?v=')[1].split('&')[0];
                        return videoId ? `https://www.youtube.com/embed/${videoId}` : item.url;
                      })()}
                      title={item.title} 
                      frameborder="0" 
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                      allowfullscreen
                      class="w-full h-full"
                    ></iframe>
                  </div>
                ) : item.type === 'embed' && item.url.includes('instagram.com') ? (
                  <div class="w-full rounded-lg overflow-hidden border border-gray-200 dark:border-slate-700 bg-white">
                    <iframe 
                      src={(() => {
                        try {
                          const u = new URL(item.url);
                          let p = u.pathname;
                          if (!p.endsWith('/')) p += '/';
                          return `https://www.instagram.com${p}embed/`;
                        } catch(e) { return item.url; }
                      })()}
                      class="w-full"
                      height="480"
                      frameborder="0" 
                      scrolling="no" 
                      allowtransparency="true"
                    ></iframe>
                  </div>
                ) : (
                  <a href={item.url} target="_blank" class="inline-flex items-center px-4 py-2 text-xs font-bold text-white bg-sapphire rounded-lg hover:bg-ocean transition-colors w-full justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    Visit Link
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  )}

  <!-- ADD RESOURCE DIALOG -->
  {currentTab === 'resources' && (
    <dialog id="add-resource-dialog" class="m-0 mt-auto w-full max-w-md mx-auto rounded-t-3xl p-6 bg-white dark:bg-slate-800 shadow-2xl border-0 backdrop:bg-black/40 backdrop:backdrop-blur-sm">
      <div class="flex items-center justify-between mb-5">
        <h3 class="text-lg font-bold text-gray-900 dark:text-white">Add Resource</h3>
        <button id="close-add-resource" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 p-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <div class="mb-5 bg-amber-50 dark:bg-amber-900/30 p-3 rounded-xl border border-amber-200 dark:border-amber-700">
        <div class="flex items-start">
          <svg class="h-5 w-5 text-amber-500 mr-2 shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p class="text-[11px] text-amber-800 dark:text-amber-300">
            <strong>Security Reminder:<br/></strong> Ensure your linked documents are safely permissioned. Do not link publicly accessible folders if they contain unredacted PNR references or sensitive tickets.
          </p>
        </div>
      </div>

      <form method="POST" action="/api/resources" class="space-y-4">
        <input type="hidden" name="trip_id" value={id} />
        
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Resource Type</label>
          <select name="type" required class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm">
            <option value="link">Secure Link</option>
            <option value="embed">YouTube Embed (e.g. Travel Vlog)</option>
            <option value="embed">Instagram Embed</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Title</label>
          <input type="text" name="title" required class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm" placeholder="Shared Google Drive" />
        </div>
        
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">URL / Link</label>
          <input type="url" name="url" required class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm" placeholder="https://..." />
        </div>
        
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Notes <span class="text-gray-400">(optional)</span></label>
          <textarea name="notes" rows="2" class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 text-gray-900 dark:text-white focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm resize-none"></textarea>
        </div>
        
        <button type="submit" class="w-full py-3 bg-sapphire text-whisper font-semibold rounded-xl hover:bg-ocean active:scale-[0.98] transition-all">Save Resource</button>
      </form>
    </dialog>
  )}

  <script define:vars={{ baseCurrency }}>
    const CURRENCY_SYMBOLS = {
      VND: '₫',
      SGD: 'S$',
      USD: '$'
    };

    function wireCurrencyToggle(prefix, baseCurr) {
      const select = document.getElementById(`${prefix}-expense-currency`);
      const symbolSpan = document.getElementById(`${prefix}-currency-symbol`);
      const hint = document.getElementById(`${prefix}-currency-hint`);
      if (!select || !symbolSpan) return;

      function updateHint() {
        const curr = select.value;
        symbolSpan.textContent = CURRENCY_SYMBOLS[curr] || curr;
        if (!hint) return;
        if (curr === baseCurr) {
          hint.classList.add('hidden');
          hint.textContent = '';
        } else {
          hint.classList.remove('hidden');
          hint.textContent = `* Auto-converts to ${baseCurr} at reference rate`;
        }
      }

      select.addEventListener('change', updateHint);
      updateHint();
    }

    wireCurrencyToggle('add', baseCurrency);
    wireCurrencyToggle('edit', baseCurrency);

    // Edit Expense wiring
    const editExpenseDialog = document.getElementById('edit-expense-dialog');
    const closeEditExpenseBtn = document.getElementById('close-edit-expense');
    if (closeEditExpenseBtn && editExpenseDialog) {
       closeEditExpenseBtn.addEventListener('click', () => editExpenseDialog.close());
       editExpenseDialog.addEventListener('click', (e) => { if (e.target === editExpenseDialog) editExpenseDialog.close(); });
    }
    document.querySelectorAll('.edit-expense-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        document.getElementById('edit-expense-id').value = target.dataset.id || '';
        document.getElementById('edit-expense-amount').value = target.dataset.amount || '';
        document.getElementById('edit-expense-date').value = target.dataset.date || '';
        document.getElementById('edit-expense-desc').value = target.dataset.desc || '';
        document.getElementById('edit-expense-timeline').value = target.dataset.timeline || '';

        const curr = target.dataset.currency || baseCurrency;
        const currSelect = document.getElementById('edit-expense-currency');
        if (currSelect) {
          currSelect.value = curr;
          currSelect.dispatchEvent(new Event('change'));
        }

        const paidBy = target.dataset.paidBy || '';
        const paidBySelect = document.getElementById('edit-expense-paid-by');
        if (paidBySelect) {
          paidBySelect.value = paidBy;
        }

        const splitAmongRaw = target.dataset.splitAmong || '';
        let splitList = [];
        try {
          if (splitAmongRaw) splitList = JSON.parse(splitAmongRaw);
        } catch(err) {}

        const editSplitBoxes = document.querySelectorAll('.edit-split-box');
        if (editSplitBoxes.length > 0) {
          if (!splitAmongRaw || !Array.isArray(splitList) || splitList.length === 0) {
            editSplitBoxes.forEach(cb => { cb.checked = true; });
          } else {
            editSplitBoxes.forEach(cb => {
              cb.checked = splitList.includes(cb.value);
            });
          }
        }

        const imageKey = target.dataset.image || '';
        document.getElementById('edit-expense-image').value = imageKey;
        
        const previewDiv = document.getElementById('edit-expense-image-preview');
        if (previewDiv) {
          if (imageKey) {
            previewDiv.classList.remove('hidden');
            const link = previewDiv.querySelector('a');
            if (link) link.href = '/api/images/' + imageKey;
          } else {
            previewDiv.classList.add('hidden');
          }
        }

        editExpenseDialog?.showModal();
      });
    });

    // Toggle split helpers
    const toggleAddSplitBtn = document.getElementById('toggle-all-add-split');
    if (toggleAddSplitBtn) {
      toggleAddSplitBtn.addEventListener('click', () => {
        const checkboxes = document.querySelectorAll('#add-split-checkboxes input[type="checkbox"]');
        const anyChecked = Array.from(checkboxes).some(cb => cb.checked);
        checkboxes.forEach(cb => { cb.checked = !anyChecked; });
        toggleAddSplitBtn.textContent = anyChecked ? 'Select All' : 'Deselect All';
      });
    }

    const toggleEditSplitBtn = document.getElementById('toggle-all-edit-split');
    if (toggleEditSplitBtn) {
      toggleEditSplitBtn.addEventListener('click', () => {
        const checkboxes = document.querySelectorAll('.edit-split-box');
        const anyChecked = Array.from(checkboxes).some(cb => cb.checked);
        checkboxes.forEach(cb => { cb.checked = !anyChecked; });
        toggleEditSplitBtn.textContent = anyChecked ? 'Select All' : 'Deselect All';
      });
    }

    // Copy settlement breakdown
    const copySettlementBtn = document.getElementById('copy-settlement-btn');
    const copySettlementLabel = document.getElementById('copy-settlement-label');
    if (copySettlementBtn && copySettlementLabel) {
      copySettlementBtn.addEventListener('click', async () => {
        const textToCopy = copySettlementBtn.dataset.text || '';
        try {
          await navigator.clipboard.writeText(textToCopy);
          const original = copySettlementLabel.textContent;
          copySettlementLabel.textContent = '✓ Copied to Clipboard!';
          setTimeout(() => {
            copySettlementLabel.textContent = original;
          }, 2500);
        } catch (err) {
          console.error('Failed to copy settlement text:', err);
        }
      });
    }
  </script>
</Layout>
