          class="flex items-center justify-center gap-2 py-2.5 px-4 rounded-2xl bg-pale-sapphire dark:bg-nightfall/60 border border-sky-mist/40 dark:border-sapphire/30 text-nightfall dark:text-whisper font-semibold text-xs shadow-xs hover:border-sapphire hover:text-sapphire dark:hover:text-sky-mist active:scale-[0.98] transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-sapphire dark:text-sky-mist" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
          <span>Members ({members.length})</span>
        </button>

        <button
          id="open-settle-up"
          type="button"
          class="flex items-center justify-center gap-2 py-2.5 px-4 rounded-2xl bg-sapphire text-whisper font-semibold text-xs shadow-xs hover:bg-ocean active:scale-[0.98] transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
          <span>Split Bill / Settle Up</span>
        </button>
      </div>

      <!-- Date Filters -->
      {uniqueDates.length > 0 && (
        <div class="flex gap-2 overflow-x-auto pb-1 scrollbar-none -mx-1 px-1">
          <a
            href={`?tab=expenses`}
            class={`shrink-0 px-4 py-1.5 rounded-full text-xs font-bold transition-all border ${
              !filterDate
                ? 'bg-sapphire text-white border-sapphire'
                : 'bg-white dark:bg-slate-800 text-gray-500 dark:text-gray-400 border-gray-200 dark:border-slate-700'
            }`}
          >All</a>
          {uniqueDates.map((d: any) => (
            <a
              href={`?tab=expenses&expense_date=${d}`}
