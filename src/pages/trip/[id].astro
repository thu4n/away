          <h3 class="text-lg font-bold text-gray-900 dark:text-white">Bill Settlement & Split</h3>
          <p class="text-xs text-gray-500 mt-0.5">Who owes whom & balance breakdown</p>
        </div>
        <button id="close-settle-up" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 p-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
