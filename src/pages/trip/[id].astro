---
import Layout from '../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
import {
  SUPPORTED_CURRENCIES,
  formatCurrency,
  getCurrencySymbol,
  getReferenceRate
} from '../../utils/currency';
import { calculateSettlement, formatSettlementText } from '../../utils/settlement';

const { id } = Astro.params;
const db = (env as any).DB;

const tripResult = await db.prepare('SELECT * FROM trips WHERE id = ?').bind(id).first();
if (!tripResult) {
  return Astro.redirect('/404');
}

const baseCurrency = (tripResult.base_currency || 'VND').toUpperCase();

const url = new URL(Astro.request.url);
const currentTab = url.searchParams.get('tab') || 'timeline';

// Fetch timeline, expenses, resources, and trip members
const { results: timelineItems } = await db.prepare('SELECT * FROM timeline_items WHERE trip_id = ? ORDER BY day_number ASC, time_mark ASC').bind(id).all();
const { results: expenses } = await db.prepare('SELECT * FROM expenses WHERE trip_id = ? ORDER BY expense_date DESC').bind(id).all();
const { results: resources } = await db.prepare('SELECT * FROM trip_resources WHERE trip_id = ? ORDER BY created_at DESC').bind(id).all();
const { results: members } = await db.prepare('SELECT * FROM trip_members WHERE trip_id = ? ORDER BY id ASC').bind(id).all();

const memberNames = (members || []).map((m: any) => m.name);
const settlementSummary = calculateSettlement(memberNames, expenses, baseCurrency);
const settlementShareText = formatSettlementText(settlementSummary, baseCurrency, tripResult.name);

const formatDate = (date: string | Date) => {
  const d = new Date(date);
  const day = d.getDate().toString().padStart(2, '0');
  const month = (d.getMonth() + 1).toString().padStart(2, '0');
  const year = d.getFullYear();
  return `${day}/${month}/${year}`;
};

// Calculate all days of the trip
const startDate = new Date(tripResult.start_date);
const endDate = new Date(tripResult.end_date);
const diffTime = Math.abs(endDate.getTime() - startDate.getTime());
const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;

const allDayTabs = Array.from({ length: diffDays }, (_, i) => {
  const dayNum = i + 1;
  const d = new Date(startDate);
  d.setDate(startDate.getDate() + i);
  return {
    number: dayNum,
    label: `Day ${dayNum} - ${formatDate(d)}`
  };
});

// Group timeline by day
const timelineByDay: Record<number, any[]> = {};
const timelineItemById: Record<number, any> = {};
for (const item of timelineItems) {
  if (!timelineByDay[item.day_number]) timelineByDay[item.day_number] = [];
  timelineByDay[item.day_number].push(item);
  timelineItemById[item.id] = item;
}

// Active day selection
const activeDayParam = url.searchParams.get('day');
const activeDay = activeDayParam ? Number(activeDayParam) : 1;
const activeDayItems = timelineByDay[activeDay] ?? [];

const totalExpenses = expenses.reduce((acc: number, curr: any) => acc + (curr.base_amount ?? curr.amount ?? 0), 0);

// Subtitle generator: indicates converted equivalent (defaults to VND or trip base)
const getExpenseSubtitle = (exp: any): string | null => {
  const expCurr = (exp.currency || baseCurrency).toUpperCase();
  // Same currency as trip base and base is VND -> no conversion subtitle needed
  if (expCurr === 'VND' && baseCurrency === 'VND') {
    return null;
  }
  // Logged in VND but trip base is foreign (e.g. SGD or USD) -> show converted in trip base
  if (expCurr === 'VND' && baseCurrency !== 'VND') {
    const converted = exp.base_amount ?? (exp.amount * getReferenceRate('VND', baseCurrency));
    return `≈ ${formatCurrency(converted, baseCurrency)}`;
  }
  // Foreign expense on a VND trip -> show converted in VND
  if (baseCurrency === 'VND') {
    const converted = exp.base_amount ?? (exp.amount * getReferenceRate(expCurr, 'VND'));
    return `≈ ${formatCurrency(converted, 'VND')}`;
  }
  // Foreign expense on a foreign trip (e.g. SGD expense on SGD trip) -> show preferred VND subtitle
  if (expCurr === 'SGD') {
    return `≈ ${formatCurrency(exp.amount * 19000, 'VND')}`;
  }
  if (expCurr === 'USD') {
    return `≈ ${formatCurrency(exp.amount * 25400, 'VND')}`;
  }
  return null;
};

// Expense filtering
const filterDate = url.searchParams.get('expense_date');
const uniqueDates = [...new Set(expenses.map((e: any) => e.expense_date))].sort((a: any, b: any) => new Date(b).getTime() - new Date(a).getTime());
const displayExpenses = filterDate ? expenses.filter((e: any) => e.expense_date === filterDate) : expenses;

const displayTotalBase = displayExpenses.reduce((acc: number, e: any) => acc + (e.base_amount ?? e.amount ?? 0), 0);
const displayTotalVnd = displayExpenses.reduce((acc: number, e: any) => {
  const curr = (e.currency || baseCurrency).toUpperCase();
  return acc + (curr === 'VND' ? e.amount : e.amount * getReferenceRate(curr, 'VND'));
}, 0);

---

<Layout title={`${tripResult.name} - Away`}>
  <!-- Sticky Header for Trip Name & Tabs -->
  <div class="sticky top-0 z-40 bg-[var(--bg-color)]/90 backdrop-blur-md pt-4 pb-2 border-b border-gray-200 dark:border-slate-800 -mx-4 px-4 mb-6">
    <div class="flex items-center justify-between mb-4">
      <a href="/" class="p-2 -ml-2 text-gray-400 hover:text-blue-500 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </a>
      <h1 class="text-xl font-bold truncate">{tripResult.name}</h1>
      <!-- Action buttons (Export CSV & Add Item) -->
      <div class="flex items-center space-x-2">
        <a
          href={`/api/export?id=${tripResult.id}`}
          download
          title="Export Trip to CSV"
          class="w-9 h-9 flex items-center justify-center bg-pale-sapphire dark:bg-nightfall/60 text-sapphire dark:text-sky-mist rounded-full shadow border border-sky-mist/30 dark:border-sapphire/30 hover:bg-sky-mist/20 active:scale-95 transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
        </a>
        {currentTab === 'timeline' ? (
          <button id="open-add-event" class="w-9 h-9 flex items-center justify-center bg-sapphire text-white rounded-full shadow-lg hover:bg-ocean active:scale-95 transition-all font-bold" title="Add Event">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="white">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
            </svg>
          </button>
        ) : currentTab === 'expenses' ? (
          <button id="open-add-expense" class="w-9 h-9 flex items-center justify-center bg-sapphire text-white rounded-full shadow-lg hover:bg-ocean active:scale-95 transition-all font-bold" title="Add Expense">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="white">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
            </svg>
          </button>
        ) : currentTab === 'resources' ? (
          <button id="open-add-resource" class="w-9 h-9 flex items-center justify-center bg-sapphire text-white rounded-full shadow-lg hover:bg-ocean active:scale-95 transition-all font-bold" title="Add Resource">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="white">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
            </svg>
          </button>
        ) : null}
      </div>
    </div>
    
    <!-- Custom Segmented Control for Tabs -->
    <div class="flex bg-whisper/80 dark:bg-nightfall/80 p-1 rounded-xl">
      <a href={`?tab=timeline`} class={`flex-1 text-center py-2 text-sm font-medium rounded-lg transition-all ${currentTab === 'timeline' ? 'bg-pale-sapphire dark:bg-sapphire/30 shadow text-sapphire dark:text-sky-mist' : 'text-nightfall/50 hover:text-nightfall dark:text-whisper/50 dark:hover:text-whisper'}`}>Timeline</a>
      <a href={`?tab=expenses`} class={`flex-1 text-center py-2 text-sm font-medium rounded-lg transition-all ${currentTab === 'expenses' ? 'bg-pale-sapphire dark:bg-sapphire/30 shadow text-sapphire dark:text-sky-mist' : 'text-nightfall/50 hover:text-nightfall dark:text-whisper/50 dark:hover:text-whisper'}`}>Expenses</a>
      <a href={`?tab=resources`} class={`flex-1 text-center py-2 text-sm font-medium rounded-lg transition-all ${currentTab === 'resources' ? 'bg-pale-sapphire dark:bg-sapphire/30 shadow text-sapphire dark:text-sky-mist' : 'text-nightfall/50 hover:text-nightfall dark:text-whisper/50 dark:hover:text-whisper'}`}>Resources</a>
    </div>

    <!-- Day pill tabs (only visible on timeline tab) -->
    {currentTab === 'timeline' && allDayTabs.length > 0 && (
      <div class="flex gap-2 overflow-x-auto pb-1 pt-3 scrollbar-none -mx-1 px-1">
        {allDayTabs.map(day => (
          <a
            href={`?tab=timeline&day=${day.number}`}
            class={`shrink-0 px-4 py-1.5 rounded-full text-sm font-semibold transition-all border ${
              activeDay === day.number
                ? 'bg-sapphire text-whisper border-sapphire shadow-sm'
                : 'bg-pale-sapphire dark:bg-nightfall/40 text-nightfall/70 dark:text-whisper/70 border-sky-mist/30 dark:border-sapphire/30 hover:border-sapphire hover:text-sapphire'
            }`}
          >{day.label}</a>
        ))}
      </div>
    )}
  </div>

  <!-- TRIP BANNER HERO (if cover_image_key exists) -->
  {tripResult.cover_image_key && (
    <div class="relative w-full h-44 sm:h-64 rounded-3xl overflow-hidden mb-6 shadow-sm border border-sky-mist/30 dark:border-sapphire/20 group">
      <img
        src={`/api/images/${tripResult.cover_image_key}`}
        alt={tripResult.name}
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-transparent"></div>
      <div class="absolute bottom-4 left-5 right-5 text-white flex justify-between items-end">
        <div>
          <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-white/20 backdrop-blur-md text-white mb-1.5 border border-white/20">
            {formatDate(tripResult.start_date)} – {formatDate(tripResult.end_date)}
          </span>
          <h2 class="text-2xl sm:text-3xl font-black tracking-tight drop-shadow-sm">{tripResult.name}</h2>
        </div>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-sapphire/80 text-white backdrop-blur-md border border-white/20">
          {baseCurrency}
        </span>
      </div>
    </div>
  )}

  <!-- TIMELINE TAB -->
  {currentTab === 'timeline' && (
    <div class="space-y-4 animate-in fade-in slide-in-from-bottom-2 duration-300">
      {allDayTabs.length === 0 ? (
        <div class="text-center py-16 text-gray-500">
          <div class="text-4xl mb-3">🗺️</div>
          <p class="font-medium">No events yet. Start planning!</p>
        </div>
      ) : activeDayItems.length === 0 ? (
        <div class="text-center py-12 text-gray-500">No events for Day {activeDay} yet.</div>
      ) : (
        <div class="relative pl-6 border-l-2 border-sky-mist/40 dark:border-sapphire/40 space-y-6 ml-4">
          {activeDayItems.map((item: any) => (
            <div class="relative">
              <div class="group bg-pale-sapphire dark:bg-nightfall/60 p-4 rounded-2xl shadow-sm border border-sky-mist/30 dark:border-sapphire/20">
                <div class="flex justify-between items-start mb-2">
                  <span class="text-[10px] font-extrabold text-whisper bg-sapphire px-2 py-0.5 rounded-md uppercase tracking-wider">{item.time_mark}</span>
                  
                  <div class="flex gap-2 items-center">
                    <button
                      class="edit-event-btn p-2 text-sapphire/40 hover:text-sapphire rounded-full hover:bg-sky-mist/20 transition-colors"
                      data-id={item.id}
                      data-day={item.day_number}
                      data-time={item.time_mark}
                      data-title={item.title}
                      data-url={item.maps_url || ''}
                      data-desc={item.description || ''}
                      data-image={item.image_key || ''}
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                      </svg>
                    </button>
                  </div>
                </div>
                <h3 class="font-bold text-nightfall dark:text-whisper text-lg">{item.title}</h3>
                {item.description && <p class="text-sm text-nightfall/60 dark:text-whisper/60 mt-1">{item.description}</p>}
                
                {item.image_key && (
                  <div class="mt-3 overflow-hidden rounded-xl border border-sky-mist/30 dark:border-sapphire/30 shadow-xs">
                    <a
                      href={`/api/images/${item.image_key}`}
                      target="_blank"
                      class="block group/img relative overflow-hidden bg-slate-100 dark:bg-slate-800"
                    >
                      <img
                        src={`/api/images/${item.image_key}`}
                        alt={item.title}
                        class="w-full h-44 sm:h-52 object-cover transition-transform duration-300 group-hover/img:scale-105"
                        loading="lazy"
                      />
                      <div class="absolute inset-0 bg-black/0 group-hover/img:bg-black/20 transition-colors flex items-end justify-end p-2.5">
                        <span class="opacity-0 group-hover/img:opacity-100 transition-opacity text-[11px] font-semibold bg-black/60 text-white px-2.5 py-1 rounded-lg backdrop-blur-sm flex items-center gap-1.5 shadow">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                          </svg>
                          View photo
                        </span>
                      </div>
                    </a>
                  </div>
                )}

                <div class="mt-4 pt-3 border-t border-gray-100 dark:border-slate-700 flex gap-2">
                  {item.maps_url && (
                    <a href={item.maps_url} target="_blank" class="inline-flex items-center px-3 py-1.5 text-xs font-bold text-white bg-sapphire rounded-lg hover:bg-ocean transition-colors">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      Open Maps
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  )}

  <!-- ADD EVENT DIALOG (timeline tab) -->
  {currentTab === 'timeline' && (
    <dialog id="add-event-dialog" class="m-0 mt-auto w-full max-w-md mx-auto rounded-t-3xl p-6 bg-white dark:bg-slate-800 shadow-2xl border-0 backdrop:bg-black/40 backdrop:backdrop-blur-sm">
      <div class="flex items-center justify-between mb-5">
        <h3 class="text-lg font-bold text-gray-900 dark:text-white">Add Event — Day {activeDay}</h3>
        <button id="close-add-event" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 p-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <form method="POST" action="/api/timeline" enctype="multipart/form-data" class="space-y-4">
        <input type="hidden" name="trip_id" value={id} />
        
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">Day Number</label>
            <select name="day_number" required class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm">
              {allDayTabs.map(day => (
                <option value={day.number} selected={day.number === activeDay}>{day.label}</option>
              ))}
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">Time Mark</label>
            <input type="time" name="time_mark" required class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm" />
          </div>
        </div>
        
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Title</label>
          <input type="text" name="title" required class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm" placeholder="Flight to Tokyo" />
        </div>
        
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Google Maps URL <span class="text-gray-400">(optional)</span></label>
          <input type="url" name="maps_url" class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm" placeholder="https://maps.google.com/..." />
        </div>
        
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Notes <span class="text-gray-400">(optional)</span></label>
          <textarea name="description" rows="2" class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 text-gray-900 dark:text-white focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm resize-none"></textarea>
        </div>
        
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Event Photo <span class="text-gray-400">(optional)</span></label>
          <input type="file" name="event_image" accept="image/*" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 dark:file:bg-blue-900/30 dark:file:text-blue-400 dark:hover:file:bg-blue-900/50 transition-all cursor-pointer border border-gray-200 dark:border-slate-600 rounded-xl bg-gray-50 dark:bg-slate-700/50" />
        </div>

        <button type="submit" class="w-full py-3 bg-sapphire text-whisper font-semibold rounded-xl hover:bg-ocean active:scale-[0.98] transition-all">Add to Timeline</button>
      </form>
    </dialog>
  )}

  <!-- EDIT EVENT DIALOG (timeline tab) -->
  {currentTab === 'timeline' && (
    <dialog id="edit-event-dialog" class="m-0 mt-auto w-full max-w-md mx-auto rounded-t-3xl p-6 bg-white dark:bg-slate-800 shadow-2xl border-0 backdrop:bg-black/40 backdrop:backdrop-blur-sm">
      <div class="flex items-center justify-between mb-5">
        <h3 class="text-lg font-bold text-gray-900 dark:text-white">Edit Event</h3>
        <button id="close-edit-event" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 p-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <form method="POST" action="/api/timeline" enctype="multipart/form-data" class="space-y-4">
        <input type="hidden" name="action" id="edit-event-action" value="edit" />
        <input type="hidden" name="trip_id" value={id} />
        <input type="hidden" name="id" id="edit-event-id" />
        <input type="hidden" name="image_key" id="edit-event-image" />
        
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">Day Number</label>
            <select name="day_number" id="edit-event-day" required class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm">
              {allDayTabs.map(day => (
                <option value={day.number}>{day.label}</option>
              ))}
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">Time Mark</label>
            <input type="time" name="time_mark" id="edit-event-time" required class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm" />
          </div>
        </div>
        
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Title</label>
          <input type="text" name="title" id="edit-event-title" required class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm" placeholder="Flight to Tokyo" />
        </div>
        
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Google Maps URL <span class="text-gray-400">(optional)</span></label>
          <input type="url" name="maps_url" id="edit-event-url" class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm" placeholder="https://maps.google.com/..." />
        </div>
        
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Notes <span class="text-gray-400">(optional)</span></label>
          <textarea name="description" id="edit-event-desc" rows="2" class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 text-gray-900 dark:text-white focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm resize-none"></textarea>
        </div>

        <div id="edit-event-image-preview" class="hidden mb-2">
          <label class="block text-xs font-medium text-gray-500 mb-1">Current Event Photo</label>
          <div class="relative w-full h-32 rounded-xl overflow-hidden border border-gray-200 dark:border-slate-600 mb-2 bg-gray-50 dark:bg-slate-700">
            <img id="edit-event-preview-img" src="" alt="Event photo preview" class="w-full h-full object-cover" />
          </div>
          <label class="flex items-center text-xs text-red-500 hover:text-red-600 cursor-pointer gap-1.5">
            <input type="checkbox" name="remove_image" value="true" id="edit-event-remove-image" class="rounded border-gray-300 text-red-600 focus:ring-red-500" />
            <span>Remove event photo</span>
          </label>
        </div>

        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Event Photo <span class="text-gray-400">(optional)</span></label>
          <input
            type="file"
            name="event_image"
            id="edit-event-file"
            accept="image/*"
            class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 dark:file:bg-blue-900/30 dark:file:text-blue-400 dark:hover:file:bg-blue-900/50 transition-all cursor-pointer border border-gray-200 dark:border-slate-600 rounded-xl bg-gray-50 dark:bg-slate-700/50"
          />
          <p class="text-[10px] text-gray-400 mt-1 pl-1">Uploading a new image will replace the current one.</p>
        </div>
        
        <div class="pt-4 flex flex-col gap-2">
          <button type="submit" onclick="document.getElementById('edit-event-action').value='edit'; return confirm('Save changes to this event?');" class="w-full py-3 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 active:scale-[0.98] transition-all">Save Changes</button>
          <button type="submit" onclick="document.getElementById('edit-event-action').value='delete'; return confirm('Remove this event from your timeline?');" class="w-full py-3 bg-red-600 text-white font-semibold rounded-xl hover:bg-red-700 active:scale-[0.98] transition-all">Delete Event</button>
        </div>
      </form>
    </dialog>
