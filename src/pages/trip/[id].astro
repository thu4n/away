---
import Layout from '../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';

const { id } = Astro.params;
const db = (env as any).DB;

const tripResult = await db.prepare('SELECT * FROM trips WHERE id = ?').bind(id).first();
if (!tripResult) {
  return Astro.redirect('/404');
}

const url = new URL(Astro.request.url);
const currentTab = url.searchParams.get('tab') || 'timeline';

// Fetch timeline, expenses, resources
const { results: timelineItems } = await db.prepare('SELECT * FROM timeline_items WHERE trip_id = ? ORDER BY day_number ASC, time_mark ASC').bind(id).all();
const { results: expenses } = await db.prepare('SELECT * FROM expenses WHERE trip_id = ? ORDER BY expense_date DESC').bind(id).all();
const { results: resources } = await db.prepare('SELECT * FROM trip_resources WHERE trip_id = ? ORDER BY created_at DESC').bind(id).all();

const formatDate = (date: string | Date) => {
  const d = new Date(date);
  const day = d.getDate().toString().padStart(2, '0');
  const month = (d.getMonth() + 1).toString().padStart(2, '0');
  const year = d.getFullYear();
  return `${day}/${month}/${year}`;
};

// Calculate all days of the trip
const startDate = new Date(tripResult.start_date);
const endDate = new Date(tripResult.end_date);
const diffTime = Math.abs(endDate.getTime() - startDate.getTime());
const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;

const allDayTabs = Array.from({ length: diffDays }, (_, i) => {
  const dayNum = i + 1;
  const d = new Date(startDate);
  d.setDate(startDate.getDate() + i);
  return {
    number: dayNum,
    label: `Day ${dayNum} - ${formatDate(d)}`
  };
});

// Group timeline by day
const timelineByDay: Record<number, any[]> = {};
const timelineItemById: Record<number, any> = {};
for (const item of timelineItems) {
  if (!timelineByDay[item.day_number]) timelineByDay[item.day_number] = [];
  timelineByDay[item.day_number].push(item);
  timelineItemById[item.id] = item;
}

// Active day selection
const activeDayParam = url.searchParams.get('day');
const activeDay = activeDayParam ? Number(activeDayParam) : 1;
const activeDayItems = timelineByDay[activeDay] ?? [];

const totalExpenses = expenses.reduce((acc: number, curr: any) => acc + curr.amount, 0);

const formatCurrency = (amount: number) => {
  return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
};

// Expense filtering
const filterDate = url.searchParams.get('expense_date');
const uniqueDates = [...new Set(expenses.map((e: any) => e.expense_date))].sort((a: any, b: any) => new Date(b).getTime() - new Date(a).getTime());
const displayExpenses = filterDate ? expenses.filter((e: any) => e.expense_date === filterDate) : expenses;

---

<Layout title={`${tripResult.name} - Away`}>
  <!-- Sticky Header for Trip Name & Tabs -->
  <div class="sticky top-0 z-40 bg-[var(--bg-color)]/90 backdrop-blur-md pt-4 pb-2 border-b border-gray-200 dark:border-slate-800 -mx-4 px-4 mb-6">
    <div class="flex items-center justify-between mb-4">
      <a href="/" class="p-2 -ml-2 text-gray-400 hover:text-blue-500 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </a>
      <h1 class="text-xl font-bold truncate">{tripResult.name}</h1>
      <!-- + button shown conditionally -->
      {currentTab === 'timeline' ? (
        <button id="open-add-event" class="w-9 h-9 flex items-center justify-center bg-sapphire text-white rounded-full shadow-lg hover:bg-ocean active:scale-95 transition-all font-bold">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="white">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
          </svg>
        </button>
      ) : currentTab === 'expenses' ? (
        <button id="open-add-expense" class="w-9 h-9 flex items-center justify-center bg-sapphire text-white rounded-full shadow-lg hover:bg-ocean active:scale-95 transition-all font-bold">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="white">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
          </svg>
        </button>
      ) : currentTab === 'resources' ? (
        <button id="open-add-resource" class="w-9 h-9 flex items-center justify-center bg-sapphire text-white rounded-full shadow-lg hover:bg-ocean active:scale-95 transition-all font-bold">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="white">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
          </svg>
        </button>
      ) : (
        <div class="w-9"></div>
      )}
    </div>
    
    <!-- Custom Segmented Control for Tabs -->
    <div class="flex bg-whisper/80 dark:bg-nightfall/80 p-1 rounded-xl">
      <a href={`?tab=timeline`} class={`flex-1 text-center py-2 text-sm font-medium rounded-lg transition-all ${currentTab === 'timeline' ? 'bg-pale-sapphire dark:bg-sapphire/30 shadow text-sapphire dark:text-sky-mist' : 'text-nightfall/50 hover:text-nightfall dark:text-whisper/50 dark:hover:text-whisper'}`}>Timeline</a>
      <a href={`?tab=expenses`} class={`flex-1 text-center py-2 text-sm font-medium rounded-lg transition-all ${currentTab === 'expenses' ? 'bg-pale-sapphire dark:bg-sapphire/30 shadow text-sapphire dark:text-sky-mist' : 'text-nightfall/50 hover:text-nightfall dark:text-whisper/50 dark:hover:text-whisper'}`}>Expenses</a>
      <a href={`?tab=resources`} class={`flex-1 text-center py-2 text-sm font-medium rounded-lg transition-all ${currentTab === 'resources' ? 'bg-pale-sapphire dark:bg-sapphire/30 shadow text-sapphire dark:text-sky-mist' : 'text-nightfall/50 hover:text-nightfall dark:text-whisper/50 dark:hover:text-whisper'}`}>Resources</a>
    </div>

    <!-- Day pill tabs (only visible on timeline tab) -->
    {currentTab === 'timeline' && allDayTabs.length > 0 && (
      <div class="flex gap-2 overflow-x-auto pb-1 pt-3 scrollbar-none -mx-1 px-1">
        {allDayTabs.map(day => (
          <a
            href={`?tab=timeline&day=${day.number}`}
            class={`shrink-0 px-4 py-1.5 rounded-full text-sm font-semibold transition-all border ${
              activeDay === day.number
                ? 'bg-sapphire text-whisper border-sapphire shadow-sm'
                : 'bg-pale-sapphire dark:bg-nightfall/40 text-nightfall/70 dark:text-whisper/70 border-sky-mist/30 dark:border-sapphire/30 hover:border-sapphire hover:text-sapphire'
            }`}
          >{day.label}</a>
        ))}
      </div>
    )}
  </div>
  <!-- TIMELINE TAB -->
  {currentTab === 'timeline' && (
    <div class="space-y-4 animate-in fade-in slide-in-from-bottom-2 duration-300">
      {allDayTabs.length === 0 ? (
        <div class="text-center py-16 text-gray-500">
          <div class="text-4xl mb-3">🗺️</div>
          <p class="font-medium">No events yet. Start planning!</p>
        </div>
      ) : activeDayItems.length === 0 ? (
        <div class="text-center py-12 text-gray-500">No events for Day {activeDay} yet.</div>
      ) : (
        <div class="relative pl-6 border-l-2 border-sky-mist/40 dark:border-sapphire/40 space-y-6 ml-4">
          {activeDayItems.map((item: any) => (
            <div class="relative">
              <div class="group bg-pale-sapphire dark:bg-nightfall/60 p-4 rounded-2xl shadow-sm border border-sky-mist/30 dark:border-sapphire/20">
                <div class="flex justify-between items-start mb-2">
                  <span class="text-[10px] font-extrabold text-whisper bg-sapphire px-2 py-0.5 rounded-md uppercase tracking-wider">{item.time_mark}</span>
                  
                  <div class="flex gap-2 items-center">
                    <button
                      class="edit-event-btn p-2 text-sapphire/40 hover:text-sapphire rounded-full hover:bg-sky-mist/20 transition-colors"
                      data-id={item.id}
                      data-day={item.day_number}
                      data-time={item.time_mark}
                      data-title={item.title}
                      data-url={item.maps_url || ''}
                      data-desc={item.description || ''}
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                      </svg>
                    </button>
                  </div>
                </div>
                <h3 class="font-bold text-nightfall dark:text-whisper text-lg">{item.title}</h3>
                {item.description && <p class="text-sm text-nightfall/60 dark:text-whisper/60 mt-1">{item.description}</p>}
                
                <div class="mt-4 pt-3 border-t border-gray-100 dark:border-slate-700 flex gap-2">
                  {item.maps_url && (
                    <a href={item.maps_url} target="_blank" class="inline-flex items-center px-3 py-1.5 text-xs font-bold text-white bg-sapphire rounded-lg hover:bg-ocean transition-colors">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      Open Maps
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  )}

  <!-- ADD EVENT DIALOG (timeline tab) -->
  {currentTab === 'timeline' && (
    <dialog id="add-event-dialog" class="m-0 mt-auto w-full max-w-md mx-auto rounded-t-3xl p-6 bg-white dark:bg-slate-800 shadow-2xl border-0 backdrop:bg-black/40 backdrop:backdrop-blur-sm">
      <div class="flex items-center justify-between mb-5">
        <h3 class="text-lg font-bold text-gray-900 dark:text-white">Add Event — Day {activeDay}</h3>
        <button id="close-add-event" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 p-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <form method="POST" action="/api/timeline" class="space-y-4">
        <input type="hidden" name="trip_id" value={id} />
        
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">Day Number</label>
            <select name="day_number" required class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm">
              {allDayTabs.map(day => (
                <option value={day.number} selected={day.number === activeDay}>{day.label}</option>
              ))}
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">Time Mark</label>
            <input type="time" name="time_mark" required class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm" />
          </div>
        </div>
        
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Title</label>
          <input type="text" name="title" required class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm" placeholder="Flight to Tokyo" />
        </div>
        
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Google Maps URL <span class="text-gray-400">(optional)</span></label>
          <input type="url" name="maps_url" class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm" placeholder="https://maps.google.com/..." />
        </div>
        
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Notes <span class="text-gray-400">(optional)</span></label>
          <textarea name="description" rows="2" class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 text-gray-900 dark:text-white focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm resize-none"></textarea>
        </div>
        
        <button type="submit" class="w-full py-3 bg-sapphire text-whisper font-semibold rounded-xl hover:bg-ocean active:scale-[0.98] transition-all">Add to Timeline</button>
      </form>
    </dialog>
  )}

  <!-- EDIT EVENT DIALOG (timeline tab) -->
  {currentTab === 'timeline' && (
    <dialog id="edit-event-dialog" class="m-0 mt-auto w-full max-w-md mx-auto rounded-t-3xl p-6 bg-white dark:bg-slate-800 shadow-2xl border-0 backdrop:bg-black/40 backdrop:backdrop-blur-sm">
      <div class="flex items-center justify-between mb-5">
        <h3 class="text-lg font-bold text-gray-900 dark:text-white">Edit Event</h3>
        <button id="close-edit-event" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 p-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <form method="POST" action="/api/timeline" class="space-y-4">
        <input type="hidden" name="action" id="edit-event-action" value="edit" />
        <input type="hidden" name="trip_id" value={id} />
        <input type="hidden" name="id" id="edit-event-id" />
        
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">Day Number</label>
            <select name="day_number" id="edit-event-day" required class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm">
              {allDayTabs.map(day => (
                <option value={day.number}>{day.label}</option>
              ))}
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">Time Mark</label>
            <input type="time" name="time_mark" id="edit-event-time" required class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm" />
          </div>
        </div>
        
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Title</label>
          <input type="text" name="title" id="edit-event-title" required class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm" placeholder="Flight to Tokyo" />
        </div>
        
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Google Maps URL <span class="text-gray-400">(optional)</span></label>
          <input type="url" name="maps_url" id="edit-event-url" class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm" placeholder="https://maps.google.com/..." />
        </div>
        
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Notes <span class="text-gray-400">(optional)</span></label>
          <textarea name="description" id="edit-event-desc" rows="2" class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 text-gray-900 dark:text-white focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm resize-none"></textarea>
        </div>
        
        <div class="pt-4 flex flex-col gap-2">
          <button type="submit" onclick="document.getElementById('edit-event-action').value='edit'; return confirm('Save changes to this event?');" class="w-full py-3 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 active:scale-[0.98] transition-all">Save Changes</button>
          <button type="submit" onclick="document.getElementById('edit-event-action').value='delete'; return confirm('Remove this event from your timeline?');" class="w-full py-3 bg-red-600 text-white font-semibold rounded-xl hover:bg-red-700 active:scale-[0.98] transition-all">Delete Event</button>
        </div>
      </form>
    </dialog>
  )}

  <script>

    function wireDialog(openId: string, closeId: string, dialogId: string) {
      const openBtn = document.getElementById(openId);
      const closeBtn = document.getElementById(closeId);
      const dialog = document.getElementById(dialogId) as HTMLDialogElement | null;
      if (!dialog) return;
      openBtn?.addEventListener('click', () => dialog.showModal());
      closeBtn?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    }
    wireDialog('open-add-event',   'close-add-event',   'add-event-dialog');
    wireDialog('open-add-expense', 'close-add-expense', 'add-expense-dialog');
    wireDialog('open-add-resource', 'close-add-resource', 'add-resource-dialog');

    // Edit Event wiring
    const editEventDialog = document.getElementById('edit-event-dialog');
    const closeEditEventBtn = document.getElementById('close-edit-event');
    if (closeEditEventBtn && editEventDialog) {
      closeEditEventBtn.addEventListener('click', () => (editEventDialog as any).close());
      editEventDialog.addEventListener('click', (e) => { if (e.target === editEventDialog) (editEventDialog as any).close(); });
    }
    document.querySelectorAll('.edit-event-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        (document.getElementById('edit-event-id') as HTMLInputElement).value = target.dataset.id || '';
        (document.getElementById('edit-event-day') as HTMLInputElement).value = target.dataset.day || '';
        (document.getElementById('edit-event-time') as HTMLInputElement).value = target.dataset.time || '';
        (document.getElementById('edit-event-title') as HTMLInputElement).value = target.dataset.title || '';
        (document.getElementById('edit-event-url') as HTMLInputElement).value = target.dataset.url || '';
        (document.getElementById('edit-event-desc') as HTMLTextAreaElement).value = target.dataset.desc || '';
        (editEventDialog as any)?.showModal();
      });
    });
  </script>

  <!-- EXPENSES TAB -->
  {currentTab === 'expenses' && (
    <div class="space-y-6 animate-in fade-in slide-in-from-bottom-2 duration-300">
      
      <!-- Ledger Summary -->
      <div class="bg-gradient-to-br from-sapphire to-nightfall rounded-3xl p-6 text-whisper shadow-lg overflow-hidden relative">
        <div class="absolute top-0 right-0 -mr-8 -mt-8 w-32 h-32 rounded-full bg-sky-mist opacity-10 blur-2xl"></div>
        <h2 class="text-sky-mist/80 font-medium text-sm">{filterDate ? `Spending — ${formatDate(filterDate)}` : 'Total Expenses'}</h2>
        <div class="text-4xl font-extrabold mt-1">{formatCurrency(displayExpenses.reduce((acc: number, e: any) => acc + e.amount, 0))}</div>
      </div>

      <!-- Date Filters -->
      {uniqueDates.length > 0 && (
        <div class="flex gap-2 overflow-x-auto pb-1 scrollbar-none -mx-1 px-1">
          <a
            href={`?tab=expenses`}
            class={`shrink-0 px-4 py-1.5 rounded-full text-xs font-bold transition-all border ${
              !filterDate
                ? 'bg-sapphire text-white border-sapphire'
                : 'bg-white dark:bg-slate-800 text-gray-500 dark:text-gray-400 border-gray-200 dark:border-slate-700'
            }`}
          >All</a>
          {uniqueDates.map((d: any) => (
            <a
              href={`?tab=expenses&expense_date=${d}`}
              class={`shrink-0 px-4 py-1.5 rounded-full text-xs font-bold transition-all border ${
                filterDate === d
                  ? 'bg-sapphire text-whisper border-sapphire'
                  : 'bg-pale-sapphire dark:bg-nightfall/40 text-nightfall/60 dark:text-whisper/60 border-sky-mist/30 dark:border-sapphire/30'
              }`}
            >{formatDate(d)}</a>
          ))}
        </div>
      )}

      <!-- Expense List -->
      <div class="bg-pale-sapphire dark:bg-nightfall/40 rounded-3xl shadow-sm border border-sky-mist/30 dark:border-sapphire/20 overflow-hidden">
        {displayExpenses.length === 0 ? (
          <div class="p-8 text-center text-gray-500">No expenses matched this date.</div>
        ) : (
          <ul class="divide-y divide-gray-100 dark:divide-slate-700">
            {displayExpenses.map((exp: any) => (
              <li class="p-4 flex justify-between items-center group">
                <div class="flex items-start gap-4 flex-1">
                  {exp.image_key && (
                    <a href={`/api/images/${exp.image_key}`} target="_blank" class="shrink-0 group/img relative overflow-hidden rounded-xl border border-gray-100 dark:border-slate-700 shadow-sm block">
                      <img src={`/api/images/${exp.image_key}`} alt="Proof" class="w-14 h-14 object-cover transition-transform group-hover/img:scale-110" />
                      <div class="absolute inset-0 bg-black/5 group-hover/img:bg-transparent transition-colors"></div>
                    </a>
                  )}
                  <div class="flex-1 min-w-0">
                    <div class="font-bold text-gray-900 dark:text-white truncate">{exp.description}</div>
                    <div class="text-xs text-gray-500 mt-1 flex flex-wrap items-center gap-2">
                      <span class="whitespace-nowrap">{formatDate(exp.expense_date)}</span>
                      {exp.timeline_item_id && timelineItemById[exp.timeline_item_id] && (
                        <span class="bg-blue-50 text-blue-600 dark:bg-blue-900/40 dark:text-blue-300 px-1.5 py-0.5 rounded text-[10px] font-semibold truncate max-w-[150px]">
                          📍 {timelineItemById[exp.timeline_item_id].title}
                        </span>
                      )}
                    </div>
                  </div>
                </div>
                <div class="text-right">
                  <div class="font-bold text-lg text-gray-900 dark:text-white mb-2">{formatCurrency(exp.amount)}</div>
                  <div class="flex gap-2 justify-end transition-opacity">
                    <button
                      class="edit-expense-btn p-2 text-sapphire/40 hover:text-sapphire rounded-full hover:bg-sky-mist/20 transition-colors"
                      data-id={exp.id}
                      data-amount={exp.amount}
                      data-date={exp.expense_date.split('T')[0]}
                      data-desc={exp.description}
                      data-timeline={exp.timeline_item_id || ''}
                      data-image={exp.image_key || ''}
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                      </svg>
                    </button>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  )}

  <!-- ADD EXPENSE DIALOG -->
  {currentTab === 'expenses' && (
    <dialog id="add-expense-dialog" class="m-0 mt-auto w-full max-w-md mx-auto rounded-t-3xl p-6 bg-white dark:bg-slate-800 shadow-2xl border-0 backdrop:bg-black/40 backdrop:backdrop-blur-sm">
      <div class="flex items-center justify-between mb-5">
        <h3 class="text-lg font-bold text-gray-900 dark:text-white">Log Expense</h3>
        <button id="close-add-expense" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 p-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <form method="POST" action="/api/expenses" enctype="multipart/form-data" class="space-y-4">
        <input type="hidden" name="trip_id" value={id} />
        
        <div class="flex gap-3">
          <div class="flex-1">
            <label class="block text-xs font-medium text-gray-500 mb-1">Amount</label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <span class="text-gray-500 font-medium">₫</span>
              </div>
              <input type="number" step="1000" inputmode="numeric" name="amount" required class="block w-full pl-7 rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 py-2.5 text-gray-900 dark:text-white focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-green-500 transition-all font-medium text-lg" placeholder="0" />
            </div>
          </div>
          <div class="flex-1">
            <label class="block text-xs font-medium text-gray-500 mb-1">Date</label>
            <input type="date" name="expense_date" required value={new Date().toISOString().split('T')[0]} class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 py-2.5 px-3 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-green-500 transition-all text-sm" />
          </div>
        </div>
        
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Description</label>
          <input type="text" name="description" required class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-green-500 transition-all text-sm" placeholder="Dinner at local market" />
        </div>

        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Link to Timeline Event <span class="text-gray-400">(optional)</span></label>
          <select name="timeline_item_id" class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-green-500 transition-all text-sm">
            <option value="">None</option>
            {timelineItems.map((item: any) => (
              <option value={item.id}>Day {item.day_number} · {item.time_mark} — {item.title}</option>
            ))}
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Proof Image <span class="text-gray-400">(optional)</span></label>
          <input type="file" name="proof_image" accept="image/*" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-green-50 file:text-green-700 hover:file:bg-green-100 dark:file:bg-green-900/30 dark:file:text-green-400 dark:hover:file:bg-green-900/50 transition-all cursor-pointer border border-gray-200 dark:border-slate-600 rounded-xl bg-gray-50 dark:bg-slate-700/50" />
        </div>
        
        <button type="submit" class="w-full py-3 bg-sapphire text-whisper font-bold rounded-xl hover:bg-ocean active:scale-[0.98] transition-all">Save Expense</button>
      </form>
    </dialog>
  )}

  <!-- EDIT EXPENSE DIALOG -->
  {currentTab === 'expenses' && (
    <dialog id="edit-expense-dialog" class="m-0 mt-auto w-full max-w-md mx-auto rounded-t-3xl p-6 bg-white dark:bg-slate-800 shadow-2xl border-0 backdrop:bg-black/40 backdrop:backdrop-blur-sm">
      <div class="flex items-center justify-between mb-5">
        <h3 class="text-lg font-bold text-gray-900 dark:text-white">Edit Expense</h3>
        <button id="close-edit-expense" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 p-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <form method="POST" action="/api/expenses" enctype="multipart/form-data" class="space-y-4">
        <input type="hidden" name="trip_id" value={id} />
        <input type="hidden" name="action" id="edit-expense-action" value="edit" />
        <input type="hidden" name="id" id="edit-expense-id" />
        <input type="hidden" name="image_key" id="edit-expense-image" />
        
        <div class="flex gap-3">
          <div class="flex-1">
            <label class="block text-xs font-medium text-gray-500 mb-1">Amount</label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <span class="text-gray-500 font-medium">₫</span>
              </div>
              <input type="number" step="1000" inputmode="numeric" name="amount" id="edit-expense-amount" required class="block w-full pl-7 rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 py-2.5 text-gray-900 dark:text-white focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-green-500 transition-all font-medium text-lg" placeholder="0" />
            </div>
          </div>
          <div class="flex-1">
            <label class="block text-xs font-medium text-gray-500 mb-1">Date</label>
            <input type="date" name="expense_date" id="edit-expense-date" required class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 py-2.5 px-3 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-green-500 transition-all text-sm" />
          </div>
        </div>
        
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Description</label>
          <input type="text" name="description" id="edit-expense-desc" required class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-green-500 transition-all text-sm" placeholder="Dinner at local market" />
        </div>

        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Link to Timeline Event <span class="text-gray-400">(optional)</span></label>
          <select name="timeline_item_id" id="edit-expense-timeline" class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-green-500 transition-all text-sm">
            <option value="">None</option>
            {timelineItems.map((item: any) => (
              <option value={item.id}>Day {item.day_number} · {item.time_mark} — {item.title}</option>
            ))}
          </select>
        </div>

        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Proof Image <span class="text-gray-400">(optional)</span></label>
          <div id="edit-expense-image-preview" class="hidden mb-2">
            <a href="#" target="_blank" class="inline-flex items-center px-3 py-1.5 text-xs font-semibold bg-gray-100 text-gray-700 dark:bg-slate-700 hover:bg-gray-200 dark:hover:bg-slate-600 dark:text-gray-200 rounded-lg transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              View Current Image
            </a>
          </div>
          <input type="file" name="proof_image" accept="image/*" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 dark:file:bg-blue-900/30 dark:file:text-blue-400 dark:hover:file:bg-blue-900/50 transition-all cursor-pointer border border-gray-200 dark:border-slate-600 rounded-xl bg-gray-50 dark:bg-slate-700/50" />
          <p class="text-[10px] text-gray-400 mt-1 pl-1">Uploading a new image will replace the current one.</p>
        </div>
        
        <div class="pt-4 flex flex-col gap-2">
          <button type="submit" onclick="document.getElementById('edit-expense-action').value='edit'; return confirm('Save expense changes?');" class="w-full py-3 bg-sapphire text-whisper font-semibold rounded-xl hover:bg-ocean active:scale-[0.98] transition-all">Save Changes</button>
          <button type="submit" onclick="document.getElementById('edit-expense-action').value='delete'; return confirm('Remove this expense record?');" class="w-full py-3 bg-red-600 text-white font-semibold rounded-xl hover:bg-red-700 active:scale-[0.98] transition-all">Delete Expense</button>
        </div>
      </form>
    </dialog>
  )}

  <!-- RESOURCES TAB -->
  {currentTab === 'resources' && (
    <div class="space-y-4 animate-in fade-in slide-in-from-bottom-2 duration-300">
      {resources.length === 0 ? (
        <div class="text-center py-16 text-gray-500">
          <div class="text-4xl mb-3">📁</div>
          <p class="font-medium">No resources added yet.</p>
        </div>
      ) : (
        <div class="flex flex-col gap-6">
          {resources.map((item: any) => (
            <div class="group bg-pale-sapphire dark:bg-nightfall/60 p-4 rounded-2xl shadow-sm border border-sky-mist/30 dark:border-sapphire/20 flex flex-col relative w-full overflow-hidden">
              
              <div class="flex justify-between items-start mb-3">
                <span class="text-[10px] font-extrabold text-whisper bg-sapphire px-2 py-0.5 rounded-md uppercase tracking-wider">{item.type}</span>
                
                <form method="POST" action="/api/resources" class="inline" onsubmit="return confirm('Delete this resource?');">
                  <input type="hidden" name="action" value="delete" />
                  <input type="hidden" name="id" value={item.id} />
                  <input type="hidden" name="trip_id" value={id} />
                  <button type="submit" class="p-2 text-red-400 hover:text-red-600 rounded-full hover:bg-red-50/10 transition-colors -m-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                </form>
              </div>

              <h3 class="font-bold text-nightfall dark:text-whisper text-lg mb-2">{item.title}</h3>
              {item.notes && <p class="text-sm text-nightfall/60 dark:text-whisper/60 mb-4">{item.notes}</p>}
              
              <div class="mt-auto">
                {item.type === 'embed' && (item.url.includes('youtube.com') || item.url.includes('youtu.be')) ? (
                  <div class="aspect-video w-full rounded-lg overflow-hidden border border-gray-200 dark:border-slate-700">
                    <iframe 
                      src={(() => {
                        let videoId = '';
                        if (item.url.includes('youtu.be/')) videoId = item.url.split('youtu.be/')[1].split('?')[0];
                        else if (item.url.includes('watch?v=')) videoId = item.url.split('watch?v=')[1].split('&')[0];
                        return videoId ? `https://www.youtube.com/embed/${videoId}` : item.url;
                      })()}
                      title={item.title} 
                      frameborder="0" 
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                      allowfullscreen
                      class="w-full h-full"
                    ></iframe>
                  </div>
                ) : item.type === 'embed' && item.url.includes('instagram.com') ? (
                  <div class="w-full rounded-lg overflow-hidden border border-gray-200 dark:border-slate-700 bg-white">
                    <iframe 
                      src={(() => {
                        try {
                          const u = new URL(item.url);
                          let p = u.pathname;
                          if (!p.endsWith('/')) p += '/';
                          return `https://www.instagram.com${p}embed/`;
                        } catch(e) { return item.url; }
                      })()}
                      class="w-full"
                      height="480"
                      frameborder="0" 
                      scrolling="no" 
                      allowtransparency="true"
                    ></iframe>
                  </div>
                ) : (
                  <a href={item.url} target="_blank" class="inline-flex items-center px-4 py-2 text-xs font-bold text-white bg-sapphire rounded-lg hover:bg-ocean transition-colors w-full justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    Visit Link
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  )}

  <!-- ADD RESOURCE DIALOG -->
  {currentTab === 'resources' && (
    <dialog id="add-resource-dialog" class="m-0 mt-auto w-full max-w-md mx-auto rounded-t-3xl p-6 bg-white dark:bg-slate-800 shadow-2xl border-0 backdrop:bg-black/40 backdrop:backdrop-blur-sm">
      <div class="flex items-center justify-between mb-5">
        <h3 class="text-lg font-bold text-gray-900 dark:text-white">Add Resource</h3>
        <button id="close-add-resource" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 p-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <div class="mb-5 bg-amber-50 dark:bg-amber-900/30 p-3 rounded-xl border border-amber-200 dark:border-amber-700">
        <div class="flex items-start">
          <svg class="h-5 w-5 text-amber-500 mr-2 shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p class="text-[11px] text-amber-800 dark:text-amber-300">
            <strong>Security Reminder:<br/></strong> Ensure your linked documents are safely permissioned. Do not link publicly accessible folders if they contain unredacted PNR references or sensitive tickets.
          </p>
        </div>
      </div>

      <form method="POST" action="/api/resources" class="space-y-4">
        <input type="hidden" name="trip_id" value={id} />
        
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Resource Type</label>
          <select name="type" required class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm">
            <option value="link">Secure Link</option>
            <option value="embed">YouTube Embed (e.g. Travel Vlog)</option>
            <option value="embed">Instagram Embed</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Title</label>
          <input type="text" name="title" required class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm" placeholder="Shared Google Drive" />
        </div>
        
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">URL / Link</label>
          <input type="url" name="url" required class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm" placeholder="https://..." />
        </div>
        
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Notes <span class="text-gray-400">(optional)</span></label>
          <textarea name="notes" rows="2" class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 text-gray-900 dark:text-white focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-blue-500 transition-all text-sm resize-none"></textarea>
        </div>
        
        <button type="submit" class="w-full py-3 bg-sapphire text-whisper font-semibold rounded-xl hover:bg-ocean active:scale-[0.98] transition-all">Save Resource</button>
      </form>
    </dialog>
  )}

  <script>
    // Edit Expense wiring
    const editExpenseDialog = document.getElementById('edit-expense-dialog');
    const closeEditExpenseBtn = document.getElementById('close-edit-expense');
    if (closeEditExpenseBtn && editExpenseDialog) {
       closeEditExpenseBtn.addEventListener('click', () => (editExpenseDialog as any).close());
       editExpenseDialog.addEventListener('click', (e) => { if (e.target === editExpenseDialog) (editExpenseDialog as any).close(); });
    }
    document.querySelectorAll('.edit-expense-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        (document.getElementById('edit-expense-id') as HTMLInputElement).value = target.dataset.id || '';
        (document.getElementById('edit-expense-amount') as HTMLInputElement).value = target.dataset.amount || '';
        (document.getElementById('edit-expense-date') as HTMLInputElement).value = target.dataset.date || '';
        (document.getElementById('edit-expense-desc') as HTMLInputElement).value = target.dataset.desc || '';
        (document.getElementById('edit-expense-timeline') as unknown as HTMLSelectElement).value = target.dataset.timeline || '';

        const imageKey = target.dataset.image || '';
        (document.getElementById('edit-expense-image') as HTMLInputElement).value = imageKey;
        
        const previewDiv = document.getElementById('edit-expense-image-preview');
        if (previewDiv) {
          if (imageKey) {
            previewDiv.classList.remove('hidden');
            const link = previewDiv.querySelector('a');
            if (link) link.href = '/api/images/' + imageKey;
          } else {
            previewDiv.classList.add('hidden');
          }
        }

        (editExpenseDialog as any)?.showModal();
      });
    });
  </script>
</Layout>
