          <p id="edit-currency-hint" class="text-[11px] text-gray-400 mt-1 hidden"></p>
        </div>
        
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Description</label>
          <input type="text" name="description" id="edit-expense-desc" required class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-green-500 transition-all text-sm" placeholder="Dinner at local market" />
        </div>

        <!-- Paid By Selection -->
        {members.length > 0 && (
          <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">Paid By <span class="text-gray-400">(who paid this bill)</span></label>
            <select
              name="paid_by"
              id="edit-expense-paid-by"
              class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-sapphire transition-all text-sm font-medium text-gray-900 dark:text-white"
            >
              <option value="">Select payer...</option>
              {members.map((m: any) => (
                <option value={m.name}>{m.name}</option>
              ))}
            </select>
          </div>
        )}

        <!-- Split Among Checkboxes -->
        {members.length > 0 && (
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="block text-xs font-medium text-gray-500">Split Between</label>
              <button
                type="button"
                id="toggle-all-edit-split"
                class="text-[11px] text-sapphire dark:text-sky-mist font-semibold hover:underline"
              >
                Select All
              </button>
            </div>
            <div class="grid grid-cols-2 gap-2" id="edit-split-checkboxes">
              {members.map((m: any) => (
                <label class="flex items-center gap-2 p-2 rounded-xl border border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-700/50 cursor-pointer hover:bg-gray-100 dark:hover:bg-slate-700 text-xs">
                  <input
                    type="checkbox"
                    name="split_among"
                    value={m.name}
                    class="edit-split-box rounded border-gray-300 text-sapphire focus:ring-sapphire"
                  />
                  <span class="truncate font-medium text-gray-800 dark:text-gray-200">{m.name}</span>
                </label>
              ))}
            </div>
          </div>
        )}

        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Link to Timeline Event <span class="text-gray-400">(optional)</span></label>
          <select name="timeline_item_id" id="edit-expense-timeline" class="block w-full rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2.5 focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-green-500 transition-all text-sm">
            <option value="">None</option>
            {timelineItems.map((item: any) => (
              <option value={item.id}>Day {item.day_number} · {item.time_mark} — {item.title}</option>
            ))}
          </select>
        </div>

        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Proof Image <span class="text-gray-400">(optional)</span></label>
          <div id="edit-expense-image-preview" class="hidden mb-2">
            <a href="#" target="_blank" class="inline-flex items-center px-3 py-1.5 text-xs font-semibold bg-gray-100 text-gray-700 dark:bg-slate-700 hover:bg-gray-200 dark:hover:bg-slate-600 dark:text-gray-200 rounded-lg transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              View Current Image
            </a>
          </div>
          <input type="file" name="proof_image" accept="image/*" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 dark:file:bg-blue-900/30 dark:file:text-blue-400 dark:hover:file:bg-blue-900/50 transition-all cursor-pointer border border-gray-200 dark:border-slate-600 rounded-xl bg-gray-50 dark:bg-slate-700/50" />
          <p class="text-[10px] text-gray-400 mt-1 pl-1">Uploading a new image will replace the current one.</p>
        </div>
        
        <div class="pt-4 flex flex-col gap-2">
          <button type="submit" onclick="document.getElementById('edit-expense-action').value='edit'; return confirm('Save expense changes?');" class="w-full py-3 bg-sapphire text-whisper font-semibold rounded-xl hover:bg-ocean active:scale-[0.98] transition-all">Save Changes</button>
          <button type="submit" onclick="document.getElementById('edit-expense-action').value='delete'; return confirm('Remove this expense record?');" class="w-full py-3 bg-red-600 text-white font-semibold rounded-xl hover:bg-red-700 active:scale-[0.98] transition-all">Delete Expense</button>
        </div>
      </form>
    </dialog>
  )}

  <!-- MANAGE MEMBERS DIALOG -->
  {currentTab === 'expenses' && (
    <dialog id="manage-members-dialog" class="m-0 mt-auto w-full max-w-md mx-auto rounded-t-3xl p-6 bg-white dark:bg-slate-800 shadow-2xl border-0 backdrop:bg-black/40 backdrop:backdrop-blur-sm max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="text-lg font-bold text-gray-900 dark:text-white">Trip Participants</h3>
          <p class="text-xs text-gray-500 mt-0.5">Members sharing expenses for this trip</p>
        </div>
        <button id="close-manage-members" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 p-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Current Members List -->
      <div class="mb-5 max-h-56 overflow-y-auto space-y-2">
        {members.length === 0 ? (
          <div class="text-center py-6 px-4 bg-gray-50 dark:bg-slate-700/50 rounded-2xl border border-dashed border-gray-200 dark:border-slate-600">
            <div class="text-2xl mb-1">👥</div>
            <p class="text-xs text-gray-500 font-medium">No participants added yet.</p>
            <p class="text-[11px] text-gray-400 mt-0.5">Add names below to track who pays and split expenses.</p>
          </div>
        ) : (
          <div class="space-y-1.5">
            {members.map((m: any) => (
              <div class="flex items-center justify-between p-2.5 rounded-xl bg-gray-50 dark:bg-slate-700/50 border border-gray-100 dark:border-slate-700">
                <div class="flex items-center gap-2.5">
                  <span class="w-7 h-7 rounded-full bg-sapphire/10 dark:bg-sky-mist/20 text-sapphire dark:text-sky-mist font-bold text-xs flex items-center justify-center">
                    {m.name.charAt(0).toUpperCase()}
                  </span>
                  <span class="text-sm font-semibold text-gray-900 dark:text-white">{m.name}</span>
                </div>
                <form method="POST" action="/api/members" onsubmit="return confirm('Remove this member? Expenses already logged will retain their history.');">
                  <input type="hidden" name="action" value="delete" />
                  <input type="hidden" name="trip_id" value={id} />
                  <input type="hidden" name="id" value={m.id} />
                  <button type="submit" class="p-1.5 text-red-400 hover:text-red-600 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors" title="Remove member">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                </form>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Add Member Form -->
      <form method="POST" action="/api/members" class="space-y-3 pt-3 border-t border-gray-100 dark:border-slate-700">
        <input type="hidden" name="action" value="add" />
        <input type="hidden" name="trip_id" value={id} />
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Add Participant(s)</label>
          <div class="flex gap-2">
            <input
              type="text"
              name="name"
              required
              placeholder="e.g. Thuận, Alex, Sarah"
              class="block flex-1 rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 px-3 py-2 text-gray-900 dark:text-white focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-sapphire transition-all text-sm"
            />
            <button
              type="submit"
              class="px-4 py-2 bg-sapphire text-whisper font-semibold text-xs rounded-xl hover:bg-ocean active:scale-95 transition-all shrink-0"
            >
              Add
            </button>
          </div>
          <p class="text-[10px] text-gray-400 mt-1">Tip: Add multiple names at once separated by commas.</p>
        </div>
      </form>
    </dialog>
  )}

