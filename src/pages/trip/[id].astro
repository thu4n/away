              <span id="edit-currency-symbol" class="text-gray-500 font-bold">{getCurrencySymbol(baseCurrency)}</span>
            </div>
            <input type="number" step="any" inputmode="decimal" name="amount" id="edit-expense-amount" required class="block w-full pl-9 rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/50 py-2.5 text-gray-900 dark:text-white focus:bg-white dark:focus:bg-slate-700 focus:ring-2 focus:ring-sapphire transition-all font-medium text-lg" placeholder="0" />
