  <!-- EDIT EXPENSE DIALOG -->
  {currentTab === 'expenses' && (
    <dialog id="edit-expense-dialog" class="m-0 mt-auto w-full max-w-md mx-auto rounded-t-3xl p-6 bg-white dark:bg-slate-800 shadow-2xl border-0 backdrop:bg-black/40 backdrop:backdrop-blur-sm max-h-[90vh] overflow-y-auto">
