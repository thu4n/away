---
import Layout from "../layouts/Layout.astro";
import { env } from "cloudflare:workers";

const db = (env as any).DB;
const { results: trips } = await db
  .prepare("SELECT * FROM trips ORDER BY start_date ASC")
  .all();

const formatDate = (date: string | Date) => {
  const d = new Date(date);
  const day = d.getDate().toString().padStart(2, "0");
  const month = (d.getMonth() + 1).toString().padStart(2, "0");
  const year = d.getFullYear();
  return `${day}/${month}/${year}`;
};
---

<Layout title="Away">
  <div class="space-y-6">
    <header class="pt-6 pb-2">
      <h1
        class="text-3xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-sapphire to-nightfall dark:from-sky-mist dark:to-sapphire"
      >
        Away
      </h1>
      <p class="text-gray-500 dark:text-gray-400 mt-1">
        Plan your trips and log expense.
      </p>
    </header>

    <div class="grid gap-4">
      {
        trips.map((trip: any) => (
          <a
            href={`/trip/${trip.id}`}
            class="group block relative p-5 bg-pale-sapphire dark:bg-nightfall/60 rounded-2xl shadow-sm hover:shadow-md border border-sky-mist/30 dark:border-sapphire/30 transition-all focus:outline-none focus:ring-2 focus:ring-sapphire focus:ring-offset-2 dark:focus:ring-offset-nightfall"
          >
            <h2 class="text-xl font-bold text-nightfall dark:text-whisper group-hover:text-sapphire dark:group-hover:text-sky-mist transition-colors">
              {trip.name}
            </h2>
            <div class="flex items-center text-sm text-gray-500 dark:text-gray-400 mt-2 space-x-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                />
              </svg>
              <span>
                {formatDate(trip.start_date)} - {formatDate(trip.end_date)}
              </span>
            </div>

            <button
              class="edit-trip-btn absolute top-4 right-4 z-10 p-2 text-sapphire/50 hover:text-sapphire rounded-full hover:bg-sky-mist/20 transition-colors"
              aria-label="Edit Trip"
              onclick="event.preventDefault();"
              data-id={trip.id}
              data-name={trip.name}
              data-start={trip.start_date}
              data-end={trip.end_date}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
                />
              </svg>
            </button>
          </a>
        ))
      }
    </div>

    <!-- Create Trip Form -->
    <div
      class="mt-8 p-6 bg-pale-sapphire dark:bg-nightfall/40 rounded-3xl border border-sky-mist/30 dark:border-sapphire/20"
    >
      <h2 class="text-xl font-bold text-nightfall dark:text-whisper mb-4">
        Add New Trip
      </h2>
      <form method="POST" action="/api/trips" class="space-y-4">
        <div>
          <label
            for="name"
            class="block text-sm font-medium text-nightfall/60 dark:text-whisper/60"
            >Trip Name</label
          >
          <input
            type="text"
            name="name"
            id="name"
            required
            placeholder="Japan 2024"
            class="mt-1 block w-full rounded-xl border-sky-mist/30 dark:border-sapphire/30 bg-white dark:bg-nightfall/60 shadow-sm focus:border-sapphire focus:ring-sapphire px-4 py-3 text-base transition-colors"
          />
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label
              for="start_date"
              class="block text-sm font-medium text-nightfall/60 dark:text-whisper/60"
              >Start Date</label
            >
            <input
              type="date"
              name="start_date"
              id="start_date"
              required
              class="mt-1 block w-full rounded-xl border-sky-mist/30 dark:border-sapphire/30 bg-white dark:bg-nightfall/60 shadow-sm focus:border-sapphire focus:ring-sapphire px-4 py-3 text-base transition-colors"
            />
          </div>
          <div>
            <label
              for="end_date"
              class="block text-sm font-medium text-nightfall/60 dark:text-whisper/60"
              >End Date</label
            >
            <input
              type="date"
              name="end_date"
              id="end_date"
              required
              class="mt-1 block w-full rounded-xl border-sky-mist/30 dark:border-sapphire/30 bg-white dark:bg-nightfall/60 shadow-sm focus:border-sapphire focus:ring-sapphire px-4 py-3 text-base transition-colors"
            />
          </div>
        </div>
        <button
          type="submit"
          class="w-full flex justify-center py-3 px-4 border border-transparent rounded-xl shadow-sm text-base font-bold text-white bg-sapphire hover:bg-ocean focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sapphire dark:focus:ring-offset-nightfall transition-all active:scale-[0.98]"
        >
          Add Trip
        </button>
      </form>
    </div>

    <!-- Edit Trip Dialog -->
    <dialog
      id="edit-trip-dialog"
      class="m-0 mt-auto w-full max-w-md mx-auto rounded-t-3xl p-6 bg-pale-sapphire dark:bg-nightfall shadow-2xl border-0 backdrop:bg-black/40 backdrop:backdrop-blur-sm"
    >
      <div class="flex items-center justify-between mb-5">
        <h3 class="text-lg font-bold text-nightfall dark:text-whisper">
          Edit Trip
        </h3>
        <button
          id="close-edit-dialog"
          class="text-sapphire/50 hover:text-sapphire p-1"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <form method="POST" action="/api/trips" class="space-y-4">
        <input type="hidden" name="action" id="edit-trip-action" value="edit" />
        <input type="hidden" name="id" id="edit-trip-id" />
        <div>
          <label
            for="edit_name"
            class="block text-sm font-medium text-nightfall/60 dark:text-whisper/60"
            >Trip Name</label
          >
          <input
            type="text"
            name="name"
            id="edit_name"
            required
            class="mt-1 block w-full rounded-xl border-sky-mist/30 dark:border-sapphire/30 bg-white dark:bg-nightfall/60 shadow-sm focus:border-sapphire focus:ring-sapphire px-4 py-3 text-base"
          />
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label
              for="edit_start_date"
              class="block text-sm font-medium text-nightfall/60 dark:text-whisper/60"
              >Start Date</label
            >
            <input
              type="date"
              name="start_date"
              id="edit_start_date"
              required
              class="mt-1 block w-full rounded-xl border-sky-mist/30 dark:border-sapphire/30 bg-white dark:bg-nightfall/60 shadow-sm focus:border-sapphire focus:ring-sapphire px-4 py-3 text-base"
            />
          </div>
          <div>
            <label
              for="edit_end_date"
              class="block text-sm font-medium text-nightfall/60 dark:text-whisper/60"
              >End Date</label
            >
            <input
              type="date"
              name="end_date"
              id="edit_end_date"
              required
              class="mt-1 block w-full rounded-xl border-sky-mist/30 dark:border-sapphire/30 bg-white dark:bg-nightfall/60 shadow-sm focus:border-sapphire focus:ring-sapphire px-4 py-3 text-base"
            />
          </div>
        </div>
        <div class="pt-4 flex flex-col gap-2">
          <button
            type="submit"
            onclick="document.getElementById('edit-trip-action').value='edit'; return confirm('Save these changes?');"
            class="w-full py-3 bg-sapphire text-white font-semibold rounded-xl hover:bg-ocean active:scale-[0.98] transition-all"
            >Save Changes</button
          >
          <button
            type="submit"
            onclick="document.getElementById('edit-trip-action').value='delete'; return confirm('Permanently delete this entire trip and all its contents?');"
            class="w-full py-3 bg-red-600 text-white font-semibold rounded-xl hover:bg-red-700 active:scale-[0.98] transition-all"
            >Delete Trip</button
          >
        </div>
      </form>
    </dialog>
  </div>

  <script>
    const dialog = document.getElementById("edit-trip-dialog") as any;
    const closeBtn = document.getElementById("close-edit-dialog");

    document.querySelectorAll(".edit-trip-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.getAttribute("data-id");
        const name = target.getAttribute("data-name");
        const start = target.getAttribute("data-start");
        const end = target.getAttribute("data-end");

        (document.getElementById("edit-trip-id") as HTMLInputElement).value =
          id || "";
        (document.getElementById("edit_name") as HTMLInputElement).value =
          name || "";
        (document.getElementById("edit_start_date") as HTMLInputElement).value =
          start || "";
        (document.getElementById("edit_end_date") as HTMLInputElement).value =
          end || "";

        dialog.showModal();
      });
    });

    closeBtn?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (e: any) => {
      if (e.target === dialog) dialog.close();
    });
  </script>
</Layout>
